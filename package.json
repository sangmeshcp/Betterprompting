{
  "name": "betterprompting",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source analytics and prompt-optimization layer for AI coding tools (Cursor, Claude, Copilot).",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:proxy dev:web",
    "dev:proxy": "npm --workspace apps/proxy run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspaces run build --if-present",
    "start:proxy": "npm --workspace apps/proxy run start",
    "start:web": "npm --workspace apps/web run start",
    "db:init": "npm --workspace packages/db run init",
    "lint": "npm --workspaces run lint --if-present"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
