# Optional: override where SQLite lives. Defaults to ~/.betterprompting/
# BETTERPROMPTING_DIR=/var/lib/betterprompting
# BETTERPROMPTING_DB=/custom/path/betterprompting.db

# Listen address
HOST=127.0.0.1
PORT=8787

# Upstream URLs (override for testing / self-hosted gateways)
ANTHROPIC_UPSTREAM=https://api.anthropic.com
OPENAI_UPSTREAM=https://api.openai.com

LOG_LEVEL=info
