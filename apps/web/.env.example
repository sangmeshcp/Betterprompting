# Shared SQLite database path (must match the proxy's)
BETTERPROMPTING_DB=../../data/betterprompting.db

# Required for the AI workflow (prompt analyzer + rewrite).
# Without this the analyzer falls back to heuristics only.
ANTHROPIC_API_KEY=

# Public: shown on the Setup page
NEXT_PUBLIC_PROXY_URL=http://127.0.0.1:8787

# Analyzer model (any Claude model id). Defaults to claude-opus-4-7.
BETTERPROMPTING_ANALYZER_MODEL=claude-opus-4-7
